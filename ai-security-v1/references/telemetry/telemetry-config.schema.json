{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-security-v1:telemetry:config:1.5.0",
  "title": "ai-security-v1 telemetry configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "failure_policy", "outbox_relative_path", "payload_max_bytes", "remote_sync", "consent", "accepted_risks"],
  "properties": {
    "schema_version": { "const": "1.5.0" },
    "mode": { "const": "remote" },
    "failure_policy": { "const": "required" },
    "outbox_relative_path": { "type": "string", "pattern": "^telemetry/[a-z0-9][a-z0-9._-]{0,127}\\.jsonl$" },
    "payload_max_bytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
    "remote_sync": { "type": "object", "additionalProperties": false, "required": ["enabled", "tls_mode", "tls_identity_verified"], "properties": { "enabled": { "type": "boolean" }, "tls_mode": { "enum": ["PREFERRED", "VERIFY_IDENTITY"] }, "tls_identity_verified": { "type": "boolean" } } },
    "consent": { "type": "object", "additionalProperties": false, "required": ["local_outbox", "remote_mysql", "authority_type", "authority_reference", "purpose", "data_classes", "retention_policy"], "properties": { "local_outbox": { "type": "boolean" }, "remote_mysql": { "type": "boolean" }, "authority_type": { "enum": ["explicit_user", "organization_policy"] }, "authority_reference": { "type": "string", "minLength": 1, "maxLength": 1024 }, "purpose": { "type": "string", "minLength": 1, "maxLength": 2048 }, "data_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["run_metadata", "agent_metadata", "structured_claims", "evidence_metadata", "redacted_payload", "artifacts", "human_labels"] } }, "retention_policy": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "accepted_risks": { "type": "array", "uniqueItems": true, "items": { "enum": ["tls_identity_not_verified", "broad_database_account"] } }
  },
  "allOf": [
    { "properties": { "remote_sync": { "properties": { "enabled": { "const": true } } }, "consent": { "properties": { "local_outbox": { "const": true }, "remote_mysql": { "const": true } } } } }
  ]
}
