{
  "schema_version": "1.5.0",
  "database_contract": "1.3.0-core",
  "projection_policy": {
    "transaction_scope": "one_event_plus_all_normalized_projections",
    "delivery": "at_least_once_transport_idempotent_database_effect",
    "checkpoint": "local_only_after_mysql_commit",
    "unknown_event": "reject_without_projection",
    "unknown_field": "reject_according_to_event_schema",
    "database_is_a_replica": true
  },
  "events": [
    { "event_type": "run.initialized", "phase": "P0", "tables": ["audit_run", "audit_run_scope", "audit_phase_execution", "audit_payload", "audit_event"], "required_tables": ["audit_run", "audit_phase_execution"] },
    { "event_type": "run.preflight_completed", "phase": "P0", "tables": ["audit_run", "audit_event"], "required_tables": ["audit_run"] },
    { "event_type": "phase.started", "phase": "P0-P6", "tables": ["audit_phase_execution", "audit_event"], "required_tables": ["audit_phase_execution"] },
    { "event_type": "phase.completed", "phase": "P0-P6", "tables": ["audit_phase_execution", "audit_event"], "required_tables": ["audit_phase_execution"] },
    { "event_type": "agent.task_started", "phase": "P1-P5", "tables": ["audit_agent_task", "audit_payload", "audit_event"], "required_tables": ["audit_agent_task"] },
    { "event_type": "agent.task_completed", "phase": "P1-P5", "tables": ["audit_agent_task", "audit_payload", "audit_event"], "required_tables": ["audit_agent_task"] },
    { "event_type": "agent.task_discarded", "phase": "P1-P5", "tables": ["audit_agent_task", "audit_payload", "audit_event"], "required_tables": ["audit_agent_task"] },
    { "event_type": "recon.fact_recorded", "phase": "P1", "tables": ["audit_recon_fact", "audit_evidence", "audit_event"], "required_tables": ["audit_recon_fact"] },
    { "event_type": "architecture.snapshot_created", "phase": "P1", "tables": ["audit_architecture_snapshot", "audit_payload", "audit_event"], "required_tables": ["audit_architecture_snapshot"] },
    { "event_type": "coverage.seeded", "phase": "P1", "tables": ["audit_coverage_unit", "audit_event"], "required_tables": ["audit_coverage_unit"] },
    { "event_type": "coverage.check_recorded", "phase": "P1-P3", "tables": ["audit_check", "audit_evidence", "audit_event"], "required_tables": ["audit_check"] },
    { "event_type": "coverage.reopened", "phase": "P2", "tables": ["audit_coverage_attempt", "audit_coverage_unit", "audit_event"], "required_tables": ["audit_coverage_attempt", "audit_coverage_unit"] },
    { "event_type": "hunter.assigned", "phase": "P2", "tables": ["audit_agent_task", "audit_coverage_unit", "audit_payload", "audit_event"], "required_tables": ["audit_agent_task", "audit_coverage_unit"] },
    { "event_type": "hypothesis.created", "phase": "P2", "tables": ["audit_hypothesis", "audit_hypothesis_version", "audit_hypothesis_coverage", "audit_hypothesis_evidence", "audit_hypothesis_score", "audit_evidence", "audit_event"], "required_tables": ["audit_hypothesis", "audit_hypothesis_version", "audit_hypothesis_coverage", "audit_hypothesis_score"] },
    { "event_type": "hypothesis.revised", "phase": "P2", "tables": ["audit_hypothesis", "audit_hypothesis_version", "audit_hypothesis_coverage", "audit_hypothesis_evidence", "audit_hypothesis_score", "audit_evidence", "audit_event"], "required_tables": ["audit_hypothesis", "audit_hypothesis_version", "audit_hypothesis_coverage", "audit_hypothesis_score"] },
    { "event_type": "hypothesis.related", "phase": "P2", "tables": ["audit_hypothesis_relation", "audit_event"], "required_tables": ["audit_hypothesis_relation"] },
    { "event_type": "attack.plan_created", "phase": "P2", "tables": ["audit_attack_plan", "audit_attack_step", "audit_event"], "required_tables": ["audit_attack_plan", "audit_attack_step"], "requires_prior_event": ["hypothesis.created", "hypothesis.revised"] },
    { "event_type": "attack.step_observed", "phase": "P2-P3", "tables": ["audit_attack_execution", "audit_tool_execution", "audit_evidence", "audit_artifact", "audit_payload", "audit_event"], "required_tables": ["audit_attack_execution"], "requires_prior_event": ["attack.plan_created"] },
    { "event_type": "candidate.observed", "phase": "P2", "tables": ["audit_candidate_observation", "audit_payload", "audit_event"], "required_tables": ["audit_candidate_observation"] },
    { "event_type": "candidate.consolidated", "phase": "P2", "tables": ["audit_candidate", "audit_candidate_observation", "audit_candidate_hypothesis", "audit_candidate_coverage", "audit_event"], "required_tables": ["audit_candidate", "audit_candidate_observation", "audit_candidate_hypothesis", "audit_candidate_coverage"], "requires_prior_event": ["candidate.observed"] },
    { "event_type": "critic.review_completed", "phase": "P2", "tables": ["audit_agent_task", "audit_payload", "audit_event"], "required_tables": ["audit_agent_task"] },
    { "event_type": "validation.started", "phase": "P3|P5", "tables": ["audit_validation", "audit_agent_task", "audit_payload", "audit_event"], "required_tables": ["audit_validation"], "requires_prior_event": ["candidate.consolidated", "finding.revision_created"] },
    { "event_type": "validation.observation_recorded", "phase": "P3|P5", "tables": ["audit_validation_observation", "audit_evidence", "audit_tool_execution", "audit_event"], "required_tables": ["audit_validation_observation"], "requires_prior_event": ["validation.started"] },
    { "event_type": "validation.decided", "phase": "P3|P5", "tables": ["audit_decision", "audit_candidate", "audit_coverage_unit", "audit_event"], "required_tables": ["audit_decision", "audit_candidate"], "requires_prior_event": ["validation.started"] },
    { "event_type": "finding.revision_created", "phase": "P4|P5", "tables": ["audit_finding", "audit_finding_revision", "audit_finding_evidence", "audit_finding_coverage", "audit_payload", "audit_event"], "required_tables": ["audit_finding", "audit_finding_revision", "audit_finding_evidence", "audit_finding_coverage"], "requires_prior_event": ["validation.decided"] },
    { "event_type": "finding.removed", "phase": "P5", "tables": ["audit_finding", "audit_finding_revision", "audit_event"], "required_tables": ["audit_finding", "audit_finding_revision"], "requires_prior_event": ["finding.revision_created"] },
    { "event_type": "validator.completed", "phase": "P1|P4|P5", "tables": ["audit_tool_execution", "audit_artifact", "audit_payload", "audit_event"], "required_tables": ["audit_tool_execution", "audit_artifact"] },
    { "event_type": "artifact.snapshot_created", "phase": "P0-P6", "tables": ["audit_artifact", "audit_payload", "audit_event"], "required_tables": ["audit_artifact"] },
    { "event_type": "human.adjudication_recorded", "phase": "POST", "tables": ["audit_human_adjudication", "audit_payload", "audit_event"], "required_tables": ["audit_human_adjudication"] },
    { "event_type": "research.input_frozen", "phase": "POST", "tables": ["audit_event"], "required_tables": [] },
    { "event_type": "interaction.checkpoint_recorded", "phase": "P0-P6|POST", "tables": ["audit_payload", "audit_event"], "required_tables": [] },
    { "event_type": "database.operation_authorized", "phase": "P0-P6|POST", "tables": ["audit_payload", "audit_event"], "required_tables": [] },
    { "event_type": "database.operation_completed", "phase": "P0-P6|POST", "tables": ["audit_payload", "audit_event"], "required_tables": [], "requires_prior_event": ["database.operation_authorized"] },
    { "event_type": "sync.status_changed", "phase": "P0-P6", "tables": ["audit_run", "audit_event"], "required_tables": ["audit_run"] },
    { "event_type": "run.finalized", "phase": "P6", "tables": ["audit_run", "audit_phase_execution", "audit_event"], "required_tables": ["audit_run"] }
  ]
}
